# ─── Public Firebase config (client SDK) — safe to expose; prefixed NEXT_PUBLIC_ ───
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=        # GA4

# ─── Firebase Admin (server-only — NEVER prefix with NEXT_PUBLIC_) ───
FIREBASE_SERVICE_ACCOUNT_JSON=              # full service-account JSON string (store as a secret)
FIREBASE_STORAGE_BUCKET=                    # e.g. travispayne-prod.firebasestorage.app

# ─── reCAPTCHA Enterprise (forms verified server-side in Server Actions) ───
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Email: Firebase "Trigger Email" extension → SendGrid (canonical, doc 05 C3) ───
# The app does NOT call an email API directly. Server Actions write a `mail/{id}`
# Firestore doc; the extension sends via SendGrid. Configure SMTP in the extension.
NOTIFICATION_EMAIL=travis@travispayne.com

# ─── Payments — Stripe (Phase 3; Google Pay auto-enabled in Checkout) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Masterclass video — Mux signed playback (Phase 4) ───
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ─── ISR on-demand revalidation (secures POST /api/revalidate) ───
REVALIDATE_SECRET=

# ─── App ───
NEXT_PUBLIC_SITE_URL=https://travispayne.com
