# ─── Public Firebase config (client SDK) — safe to expose; prefixed NEXT_PUBLIC_ ───
# Defaults for project `travis-payne` are baked into src/lib/firebase/client.ts; set these
# only to point a build at a different Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBpUbdxwuFiSAP65QAJhNPTI-a9-30iQM8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=travis-payne.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=travis-payne
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=travis-payne.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=209328218644
NEXT_PUBLIC_FIREBASE_APP_ID=1:209328218644:web:133d521787666fe7c6fd01
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-K2EJE6W7YY        # GA4

# Comma-separated emails allowed into the visual editor (Phase: freeform builder)
NEXT_PUBLIC_EDITOR_EMAILS=

# ─── Firebase Admin (server-only — NEVER prefix with NEXT_PUBLIC_) ───
FIREBASE_SERVICE_ACCOUNT_JSON=              # full service-account JSON string (store as a secret)
FIREBASE_STORAGE_BUCKET=                    # e.g. travispayne-prod.firebasestorage.app

# ─── reCAPTCHA Enterprise (forms verified server-side in Server Actions) ───
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Email: Firebase "Trigger Email" extension → SendGrid (canonical, doc 05 C3) ───
# The app does NOT call an email API directly. Server Actions write a `mail/{id}`
# Firestore doc; the extension sends via SendGrid. Configure SMTP in the extension.
NOTIFICATION_EMAIL=travis@travispayne.com

# ─── Payments — Stripe (Phase 3; Google Pay auto-enabled in Checkout) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Masterclass video — Mux signed playback (Phase 4) ───
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ─── ISR on-demand revalidation (secures POST /api/revalidate) ───
REVALIDATE_SECRET=

# ─── App ───
NEXT_PUBLIC_SITE_URL=https://travispayne.com
