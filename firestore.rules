rules_version = '2';

// Phase 0 placeholder: locked by default. The full, collection-by-collection
// rules (public reads for published content, role-gated writes, enrollment
// checks, etc.) are specified in docs/04-backend-google-cloud.md §4 and
// docs/06-visual-editor-cms.md, and land with their respective phases.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
